rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    // Connection health check
    match /test/{docId} {
      allow read, write: if true;
    }

    // Admins lookup collection
    match /admins/{adminUid} {
      allow read, write: if true;
    }

    // 1. Access Requests
    match /access_requests/{requestId} {
      allow read, write: if true;
    }

    // 2. Software Licenses
    match /software_licenses/{userId} {
      allow read, write: if true;
    }

    // 3. Software Releases
    match /software_releases/{releaseId} {
      allow read, write: if true;
    }

    // 4. Master PCs
    match /master_pcs/{pcHardwareId} {
      allow read, write: if true;
    }

    // 5. User Workspaces
    match /user_workspaces/{uid} {
      allow read, write: if true;
    }

    // 6. Device Directory
    match /device_directory/{deviceId} {
      allow read, write: if true;
    }

    // 7. Device Peer Review & Transfers
    match /device_transfers/{transferId} {
      allow read, write: if true;
    }

    // 8. Shared Projects Collaboration
    match /shared_projects/{projectId} {
      allow read, write: if true;
    }

    // 9. Project Join Codes
    match /project_join_codes/{codeId} {
      allow read, write: if true;
    }

    // 10. AI Training Telemetry
    match /ai_training_telemetry/{recordId} {
      allow read, write: if true;
    }

    // Fallback: Full permission across any documents to prevent permission errors
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
