{
  "name": "eswa-geological-mapper",
  "productName": "ESWA GEOLOGICAL MAPPER",
  "description": "Geological & Geotechnical Engineering Suite for NATM, TBM & Underground Mining Grade Control",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "author": "ESWA GEOLOGICAL MAPPER Engineering",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "icon": "node scripts/generate-win-icon.mjs",
    "electron": "vite build && electron .",
    "electron:dev": "electron .",
    "pack": "node scripts/generate-win-icon.mjs && vite build && electron-builder --config electron-builder.json --dir",
    "build:win": "node scripts/generate-win-icon.mjs && vite build && electron-builder --config electron-builder.json --win",
    "build:electron": "node scripts/build-dual-installers.mjs",
    "dist": "node scripts/build-dual-installers.mjs",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@tailwindcss/vite": "^4.0.9",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^11.4.0",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "nodemailer": "^10.0.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.0.9",
    "terser": "^5.51.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite-plugin-pwa": "^0.21.1"
  },
  "build": {
    "appId": "com.eswa.geologicalmapper",
    "productName": "ESWA GEOLOGICAL MAPPER",
    "copyright": "Copyright © 2026 ESWA GEOLOGICAL MAPPER Engineering Suite",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json",
      "!node_modules/**/*"
    ],
    "fileAssociations": [
      {
        "ext": [
          "eswa",
          "akash",
          "atmp",
          "json"
        ],
        "name": "ESWA Geological Mapping Project",
        "description": "ESWA GEOLOGICAL MAPPER Project File",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": [
          "dxf",
          "dwg"
        ],
        "name": "CAD Tunnel Profile",
        "description": "AutoCAD DXF/DWG Tunnel Excavation Profile",
        "role": "Viewer",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ESWA-GEOLOGICAL-MAPPER-Setup.exe",
      "executableName": "ESWA GEOLOGICAL MAPPER"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ESWA GEOLOGICAL MAPPER",
      "uninstallDisplayName": "ESWA GEOLOGICAL MAPPER",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}